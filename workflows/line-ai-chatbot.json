    {
      "parameters": {
        "jsCode": "const raw = ($json.output ?? '').toString();\n\nconst looksLeaked = /^(Calling|Invoking|Using|Executing)\\s+\\S+.*(with input|tool)/i.test(raw.trim())\n  || /\"(query|location|latitude|longitude)\"\\s*:/i.test(raw);\nconst isEmpty = raw.trim() === '';\nconst isBad = looksLeaked || isEmpty;\n\nif (isBad && $runIndex === 0) {\n  return [{ json: { shouldRetry: true } }];\n}\n\nlet text;\nif (isBad) {\n  text = '不好意思，我剛剛查詢時出了點小狀況，可以麻煩再問一次嗎？';\n} else {\n  text = raw.replace(/\\{/g, '{{').replace(/\\}/g, '}}');\n}\n\nreturn [{ json: { shouldRetry: false, output: text } }];\n"
      },
