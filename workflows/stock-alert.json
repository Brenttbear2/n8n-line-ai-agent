    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nitems.sort((a, b) => new Date(b.pubDate || b.isoDate || 0) - new Date(a.pubDate || a.isoDate || 0));\nconst top = items.slice(0, 20);\nconst listText = top.map((n, i) => `${i + 1}. ${n.title}`).join('\\n');\nconst links = top.map(n => ({ title: n.title, link: n.link }));\nreturn [{ json: { newsList: listText, links } }];"
      },
