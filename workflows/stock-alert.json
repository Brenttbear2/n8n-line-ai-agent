    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nif (resp.stat !== 'OK' || !resp.data || !resp.data.length) {\n  return [{ json: { message: `⚠️ 今日無成交量排行資料（可能非交易日）` } }];\n}\nconst rows = resp.data.slice(0, 20);\nconst lines = rows.map(r => {\n  const rank = r[0], code = r[1], name = r[2], volumeRaw = r[3];\n  const shares = parseInt(String(volumeRaw).replace(/,/g, ''), 10);\n  const lots = Math.round(shares / 1000);\n  return `${rank}. ${name}(${code}) 量:${lots.toLocaleString()}張`;\n});\nconst message = `📊 今日成交量排行前20名（${resp.date}）\\n\\n${lines.join('\\n')}`;\nreturn [{ json: { message } }];"
      },
