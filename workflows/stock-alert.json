        "jsCode": "const st = $input.first().json || {};\nconst dataDate = String($('B-計算漲跌幅並篩選新警報').first().json.dataDate || '');\n// 預定休市（證交所清單內）08:00 已通知，這裡不重複推播\nif (st.ok && st.isTradingDay === false) return [];\nconst last = dataDate.length === 8 ? `${dataDate.slice(0, 4)}/${dataDate.slice(4, 6)}/${dataDate.slice(6, 8)}` : '上一個交易日';\nconst reason = st.ok ? '非預定休市（可能因颱風等因素）' : '休市原因無法確認（證交所休市日資料暫時無法取得）';\nreturn [{\n  json: {\n    message: [\n      `⚠️ 台股今日 ${st.dateLabel || ''}未開盤`,\n      reason,\n      '今日不推播盤中速報與成交量排行',\n      `目前報價仍停留在 ${last} 的收盤資料`\n    ].join('\\n')\n  }\n}];"
