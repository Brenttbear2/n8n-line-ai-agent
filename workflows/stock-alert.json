      ],
      "parameters": {
        "jsCode": "const TZ = 'Asia/Taipei';\nconst SOURCE = { 'ec.ltn.com.tw': '自由時報', 'news.ltn.com.tw': '自由時報', 'money.udn.com': '經濟日報', 'www.cnbc.com': 'CNBC', 'www.marketwatch.com': 'MarketWatch' };\nconst PER_SOURCE = 10;\nconst cutoffMs = $now.minus({ hours: 24 }).toMillis();\n\n// 只取最近24小時，每個來源各取最新10則，避免單一來源洗版\nconst groups = new Map();\nfor (const { json: n } of $input.all()) {\n  if (!n || !n.title || !n.link) continue;\n  const t = Date.parse(n.isoDate || n.pubDate || '');\n  if (!t || t < cutoffMs) continue;\n  const m = String(n.link).match(/^https?:\\/\\/([^\\/?#]+)/i);\n  if (!m) continue;\n  const host = m[1].toLowerCase();\n  if (!groups.has(host)) groups.set(host, []);\n  groups.get(host).push({ title: String(n.title).replace(/\\s+/g, ' ').trim(), link: n.link, t, source: SOURCE[host] || host });\n}\n\nconst candidates = [];\nfor (const list of groups.values()) {\n  list.sort((a, b) => b.t - a.t);\n  const seen = new Set();\n  for (const n of list) {\n    if (seen.has(n.title)) continue;\n    seen.add(n.title);\n    candidates.push({ id: candidates.length + 1, source: n.source, title: n.title, link: n.link });\n    if (seen.size >= PER_SOURCE) break;\n  }\n}\n\nconst parts = [];\ntry {\n  for (const s of $('C-取得昨日收盤').first().json.msgArray || []) {\n    const z = parseFloat(s.z || s.pz || '0');\n    const y = parseFloat(s.y || '0');\n    if (!z || !y) continue;\n    const diff = z - y;\n    const pct = (diff / y) * 100;\n    const arrow = diff > 0 ? '▲' : diff < 0 ? '▼' : '─';\n    const d = String(s.d || '');\n    const dLabel = d.length === 8 ? `${Number(d.slice(4, 6))}/${Number(d.slice(6, 8))} ` : '';\n    const name = s.n === '發行量加權股價指數' ? '加權指數' : s.n;\n    const price = z.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n    parts.push(`${name} ${dLabel}收盤 ${price} ${arrow}${Math.abs(diff).toFixed(2)}（${pct > 0 ? '+' : ''}${pct.toFixed(2)}%）`);\n  }\n} catch (e) {}\n\nreturn [{\n  json: {\n    newsList: candidates.map(c => `[${c.id}] (${c.source}) ${c.title}`).join('\\n'),\n    candidates,\n    candidateCount: candidates.length,\n    marketContext: parts.join('\\n'),\n    indexBrief: parts[0] || ''\n  }\n}];"
      }
    },
