      "id": "b1b2c3d4-0006-4b1b-9b11-000000000016",
      "name": "B-查詢即時報價",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [-336, 192]
    },
    {
      "parameters": {
        "jsCode": "const twseUrl = 'https://mis.twse.com.tw/stock/api/getStockInfo.jsp?ex_ch=tse_t00.tw|otc_o00.tw&json=1&delay=0';\nfunction sleep(ms) { return new Promise(resolve => setTimeout(resolve, ms)); }\n\nlet quoteResp = $('B-查詢即時報價').first().json;\nlet msgArray = quoteResp.msgArray || [];\n\nlet retries = 0;\nwhile (msgArray.length === 0 && retries < 2) {\n  await sleep(2000);\n  try {\n    quoteResp = await this.helpers.httpRequest({ url: twseUrl, json: true });\n  } catch (e) {\n    quoteResp = {};\n  }\n  msgArray = quoteResp.msgArray || [];\n  retries++;\n}\n\nif (msgArray.length === 0) {\n  throw new Error('台股即時報價API連續回傳空資料，已重試' + retries + '次仍失敗，本次跳過推播');\n}\n\nconst now = $now.setZone('Asia/Taipei').toFormat('HH:mm');\nconst lines = [];\nfor (const s of msgArray) {\n  const z = parseFloat(s.z || s.pz || s.b || '0');\n  const y = parseFloat(s.y || '0');\n  if (!y || !z) continue;\n  const diff = z - y;\n  const pct = (diff / y) * 100;\n  const arrow = diff > 0 ? '▲' : diff < 0 ? '▼' : '─';\n  lines.push(`${s.n} ${z.toFixed(2)} ${arrow}${Math.abs(diff).toFixed(2)} (${pct > 0 ? '+' : ''}${pct.toFixed(2)}%)`);\n}\n\nif (lines.length === 0) {\n  throw new Error('台股即時報價API有回應但無有效指數資料');\n}\n\nconst message = `📊 大盤指數速報 ${now}\\n\\n${lines.join('\\n')}`;\nreturn [{ json: { message } }];"
      },
